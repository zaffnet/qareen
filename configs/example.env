# Qareen Configuration Example
# Copy this file to .env or specify with --config-file

# =============================================================================
# Core Configuration
# =============================================================================

# Embedding models to use (JSON array format)
QAREEN_EMBEDDING_MODELS=["google/siglip-base-patch16-224"]

# Alpha values for multimodal combination (JSON array format)
QAREEN_ALPHA_VALUES=[0.0,0.5,1.0]

# Environment: dev, staging, or prod
QAREEN_ENVIRONMENT=dev

# =============================================================================
# Dataset Configuration
# =============================================================================

# Path to dataset (local directory or HuggingFace Hub name)
# Required for build_index.py and visualize_marqo_comparison.py
QAREEN_DATASET_PATH=Marqo/marqo-gs-woman-fashion

# Sample size for dev environment
QAREEN_DEV_SAMPLE_SIZE=300

# Maximum image download size in bytes
QAREEN_MAX_IMAGE_BYTES=10485760

# =============================================================================
# Directory Configuration
# =============================================================================

# Directory for dataset storage
QAREEN_DATA_DIR=data

# Directory for ChromaDB storage
QAREEN_CHROMA_DB_DIR=chroma_db

# Output directory for prepared Marqo dataset
QAREEN_MARQO_OUTPUT_DIR=data/marqo_prepared

# =============================================================================
# Indexing Configuration
# =============================================================================

# Batch size for indexing operations
QAREEN_BATCH_SIZE=3000

# Delete existing collections before indexing (true/false)
QAREEN_REBUILD_COLLECTIONS=false

# =============================================================================
# Retrieval/Visualization Configuration
# =============================================================================

# Number of similar items to retrieve in queries
QAREEN_K_NEIGHBORS=5

# Random seed for reproducible sampling
QAREEN_RANDOM_SEED=42

# Sample size for Marqo dataset preparation
QAREEN_MARQO_SAMPLE_SIZE=3000

# Output file path for visualization markdown
QAREEN_VIZ_OUTPUT_FILE=data/marqo_comparison.md
